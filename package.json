{
  "name": "spotify-clone",
  "version": "1.0.0",
  "scripts": {
    "build": "mkdir -p www && cp index.html www/"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Siapkan Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Instal Capacitor & Siapkan Web
        run: |
          npm install
          npm run build
          npx cap init "My Spotify" "com.myspotify.app" --web-dir www
          npx cap add android

      - name: Tambahkan Izin Audio & Internet Android
        run: |
          MANIFEST="android/app/src/main/AndroidManifest.xml"
          sed -i 's/<application/<application android:usesCleartextTraffic="true"/g' $MANIFEST
          sed -i 's/<uses-permission android:name="android.permission.INTERNET" \/>/<uses-permission android:name="android.permission.INTERNET" \/>\n    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" \/>\n    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" \/>/g' $MANIFEST

      - name: Rakit File APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Unggah Hasil APK
        uses: actions/upload-artifact@v4
        with:
          name: MySpotify-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
